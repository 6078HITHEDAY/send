  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "module": "src/client/main.tsx",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "bun run scripts/write-version.ts",
    "build": "bun run clean && bun run prebuild && bun run scripts/build.ts",
    "start": "bun run prebuild && bun run --hot src/server/dev.ts",
    "prod": "bun run src/server/prod.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "contributors": "git shortlog -s | awk -F\\t '{print $2}' > CONTRIBUTORS"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
