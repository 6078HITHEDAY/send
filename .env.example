# Copy to `.env` and adjust. All keys are optional unless you rely on the
# feature; defaults match `src/server/config.ts`.

# --- Runtime ---
NODE_ENV=development
# Listen address / port (dev UI: http://localhost:1443)
IP_ADDRESS=0.0.0.0
PORT=1443
# Public URL used in share links. For local dev either set this or enable detection.
BASE_URL=http://localhost:1443
DETECT_BASE_URL=false

# --- Storage ---
# Empty S3_BUCKET and GCS_BUCKET => local filesystem under FILE_DIR
FILE_DIR=
S3_BUCKET=
S3_ENDPOINT=
S3_USE_PATH_STYLE_ENDPOINT=false
GCS_BUCKET=

# --- Redis ---
# In development with REDIS_HOST=localhost the server uses an in-memory store
# (no redis-server required). Production always connects to a real Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=
REDIS_RETRY_TIME=10000
REDIS_RETRY_DELAY=500

# --- Limits ---
# Comma-separated positive integers (seconds / download counts)
EXPIRE_TIMES_SECONDS=300,3600,86400,604800
DEFAULT_EXPIRE_SECONDS=86400
MAX_EXPIRE_SECONDS=604800
DOWNLOAD_COUNTS=1,2,3,4,5,20,50,100
DEFAULT_DOWNLOADS=1
MAX_DOWNLOADS=100
MAX_FILES_PER_ARCHIVE=64
MAX_ARCHIVES_PER_USER=16
# Bytes (default ~2.5 GiB)
MAX_FILE_SIZE=2684354560

# --- Optional FxA ---
# Empty FXA_CLIENT_ID disables accounts.
FXA_URL=https://send-fxa.dev.lcip.org
FXA_CLIENT_ID=
FXA_KEY_SCOPE=https://identity.mozilla.com/apps/send
FXA_REQUIRED=false
FXA_CSP_OAUTH_URL=
FXA_CSP_CONTENT_URL=
FXA_CSP_PROFILE_URL=
FXA_CSP_PROFILEIMAGE_URL=

# --- Observability / UI chrome ---
SENTRY_CLIENT=
SENTRY_DSN=
L10N_DEV=false
CUSTOM_TITLE=Send
CUSTOM_DESCRIPTION=Encrypt and send files with a link that automatically expires to ensure your important documents don’t stay online forever.
CUSTOM_LOCALE=
SURVEY_URL=
IP_DB=

SEND_FOOTER_DONATE_URL=
SEND_FOOTER_CLI_URL=
SEND_FOOTER_DMCA_URL=
SEND_FOOTER_SOURCE_URL=https://github.com/6078HITHEDAY/send
CUSTOM_FOOTER_TEXT=
CUSTOM_FOOTER_URL=

SEND_MAIN_NOTICE_HTML=
SEND_UPLOAD_AREA_NOTICE_HTML=
SEND_UPLOADS_LIST_NOTICE_HTML=
SEND_DOWNLOAD_NOTICE_HTML=
SHOW_THUNDERBIRD_SPONSOR=false

UI_COLOR_PRIMARY=#0a84ff
UI_COLOR_ACCENT=#003eaa
UI_CUSTOM_ASSETS_ANDROID_CHROME_192PX=
UI_CUSTOM_ASSETS_ANDROID_CHROME_512PX=
UI_CUSTOM_ASSETS_APPLE_TOUCH_ICON=
UI_CUSTOM_ASSETS_FAVICON_16PX=
UI_CUSTOM_ASSETS_FAVICON_32PX=
UI_CUSTOM_ASSETS_ICON=
UI_CUSTOM_ASSETS_SAFARI_PINNED_TAB=
UI_CUSTOM_ASSETS_FACEBOOK=
UI_CUSTOM_ASSETS_TWITTER=
UI_CUSTOM_ASSETS_WORDMARK=
UI_CUSTOM_CSS=
